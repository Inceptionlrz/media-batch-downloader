# 复制为 .env.local 本地调试，或在 Vercel 项目 Settings → Environment Variables 逐项填写
# Vercel 部署时这些变量不会进代码，只在服务端运行时注入

# GitHub PAT（需 repo 权限）；建议用专门 token，不要复用账号主 token
GH_TOKEN=
# 仓库坐标
GH_OWNER=Inceptionlrz
GH_REPO=media-batch-downloader
GH_WORKFLOW=watch.yml
GH_BRANCH=main

# 飞书「群自定义机器人」webhook（bot/v2/hook/...），回执兜底通道
# 复用仓库里已配的 NOTIFY_WEBHOOK 同一个地址即可
FEISHU_WEBHOOK=

# 可选：群自定义机器人「加签」密钥。
# 若你在飞书机器人安全设置里开启了加签，则填这里（入站校验 + 出站自动带签名）；
# 若未开启加签（当前 bot 实测发送无需签名），留空即可。
FEISHU_SIGN_SECRET=

# 可选：企业自建应用的凭证。填写后启用「按 message_id 定向回复」，
# 不再依赖群自定义机器人是否还在群里（推荐，回执更稳、可定位到具体消息）。
# 需在开放平台给该应用开通消息发送相关权限（im:message）。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书域名；海外 Lark 改 https://open.larksuite.com
FEISHU_BASE=https://open.feishu.cn

# 可选：单次外部请求超时（毫秒），默认 8000
HTTP_TIMEOUT_MS=8000
# 可选：置 1 时日志打印完整 URL（默认对 webhook / token 做脱敏）
LOG_FULL_URL=0
# 本地测试/排障：置 1 强制同步执行（不用 waitUntil），便于观察完整耗时
BRIDGE_SYNC=0
