# 复制为 .env.local 本地调试，或在 Vercel 项目 Settings → Environment Variables 逐项填写
# Vercel 部署时这些变量不会进代码，只在服务端运行时注入

# GitHub PAT（需 repo 权限）；建议用专门 token，不要复用账号主 token
GH_TOKEN=
# 仓库坐标
GH_OWNER=Inceptionlrz
GH_REPO=media-batch-downloader
GH_WORKFLOW=watch.yml
GH_BRANCH=main

# 飞书机器人「发消息」webhook（bot/v2/hook/...），用于把执行结果回执到群里
# 复用仓库里已配的 NOTIFY_WEBHOOK 同一个地址即可
FEISHU_WEBHOOK=

# 可选：飞书机器人「加签」密钥。
# 若你在飞书机器人安全设置里开启了加签，则填这里（入站校验 + 出站自动带签名）；
# 若未开启加签（当前 bot 实测发送无需签名），留空即可。
FEISHU_SIGN_SECRET=
